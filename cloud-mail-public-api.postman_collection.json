{
	"info": {
		"name": "Cloud Mail Public API",
		"description": "API collection for Cloud Mail Open APIs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Generate Token",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"email\": \"admin@example.com\",\r\n  \"password\": \"your_password\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/public/genToken",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"public",
						"genToken"
					]
				},
				"description": "获取开放接口的 Token。需要提供管理员邮箱和密码。"
			},
			"response": []
		},
		{
			"name": "2. Get Email List",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "{{auth_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"num\": 1,\r\n  \"size\": 20,\r\n  \"timeSort\": \"desc\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/public/emailList",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"public",
						"emailList"
					]
				},
				"description": "获取所有邮件列表。需要在请求头携带上一步生成的 Token。\n\n支持的过滤参数 (全部可选)：\n- toEmail: 接收人邮箱\n- sendEmail: 发送人邮箱\n- sendName: 发送人名称\n- subject: 邮件主题\n- content: 邮件内容\n- type: 邮件类型\n- isDel: 是否删除(0未删除，1已删除)\n- timeSort: 排序(\"asc\"或\"desc\")\n- num: 页码\n- size: 每页数量"
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8787",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "替换为你的token",
			"type": "string"
		}
	]
}
